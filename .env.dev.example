# Dev用 Firebase プロジェクトの設定（Firebase Console → プロジェクトの設定 → マイアプリ → SDK の設定と構成）
# このファイルを .env.dev にコピーして値を入れ、`node scripts/build-config.js --env dev --local` を実行すると
# js/config.local.js が生成され、手元の `npx serve` が Dev プロジェクトに接続します。
FIREBASE_API_KEY=your_dev_api_key
FIREBASE_AUTH_DOMAIN=attendance-system-morita-dev.firebaseapp.com
FIREBASE_PROJECT_ID=attendance-system-morita-dev
FIREBASE_STORAGE_BUCKET=attendance-system-morita-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_dev_sender_id
FIREBASE_APP_ID=your_dev_app_id
